# Copy to .env only when you want to override defaults. The agent is offline-first:
# local actions work with no API key, no network, and no local LLM.
# --- Optional model profile (leave blank for offline mode) ---
MODEL_PROVIDER=none
# For OpenAI:      https://api.openai.com/v1
# For DeepSeek API: https://api.deepseek.com/v1
# For Ollama local: http://localhost:11434/v1
# For LM Studio:    http://localhost:1234/v1
# For custom:       your endpoint, must be OpenAI-chat-completions compatible
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
# Pollinations key for image_generate (https://enter.pollinations.ai)
POLLINATIONS_API_KEY=

# Optional automatic sync for newly created skills/tools. Never commit the PAT.
# Files go to agent-learned, never directly to main.
GITHUB_REPO=
GITHUB_PAT=
AUTO_PUSH_LEARNED=true

# --- Optional: native Anthropic profile (instead of openai-compatible) ---
# MODEL_PROVIDER=anthropic
# MODEL_API_URL=https://api.anthropic.com
# MODEL_API_KEY=sk-ant-xxxx
# MODEL_NAME=claude-3-5-sonnet-latest

# Extra headers for custom gateways, JSON object as string:
# MODEL_EXTRA_HEADERS={"X-Custom-Auth":"abc"}
MODEL_EXTRA_HEADERS=

# Safety: require typed confirmation for destructive ops (true/false)
REQUIRE_APPROVAL=true
# Auto-approve everything (dangerous, for automation only)
AUTO_YES=false
# Comma-separated allowed roots. Empty = allow whole machine except blocklist.
ALLOWED_ROOTS=
# Extra blocked paths (comma-separated, prefix match)
BLOCKED_PATHS=C:\Windows\System32,C:\Windows\SysWOW64
# Per-app approvals (Computer-Use style always-allow list, comma-separated exe names).
# First use of an app asks [y=once / a=always / N]; listed apps never ask.
# ALLOWED_APPS=notepad.exe,chrome.exe,msedge.exe
ALLOWED_APPS=

# Skills (comma-separated names from ./skills, without .md). Loaded into every task.
# SKILLS=wordpress-build
SKILLS=

# Skill source: local = offline bundled skills (default), auto/github = optional remote sync.
SKILL_SOURCE=local
# Private repos need a read token for remote skills (public repos don't).
# Make one: GitHub Settings -> Developer settings -> Tokens (classic), `repo` scope.
# SKILL_TOKEN=github_pat_...

# MCP servers (JSON): any MCP server's tools become mcp_<server>_<tool>.
# Use ABSOLUTE command paths on Windows (bare names often need .cmd+shell).
# MCP_SERVERS={"sqlite":{"command":"uvx","args":["mcp-server-sqlite","--db-path","C:/data/a.db"]}}

# Web dashboard: node src\index.js --ui 8080  ->  http://127.0.0.1:8080
# (chat UI, live task stream, click-to-approve; loopback only)

# Telegram phone chat: @BotFather -> /newbot -> token below, then
# node src\index.js --chat telegram   (owner-locked, per-chat memory)
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_ALLOW_FROM=<your-chat-id>  (opt; empty = first chat claims ownership)

# OpenRouter (one key, 100s of models incl. :free variants):
# MODEL_API_URL=https://openrouter.ai/api/v1
# MODEL_API_KEY=sk-or-...
# MODEL_NAME=openai/gpt-4o-mini   (or <vendor>/<model>:free)

# Omni-route fallback (one automatic retry when primary fails; free default):
# LLM_FALLBACK_URL=https://text.pollinations.ai/openai
# LLM_FALLBACK_MODEL=openai
# LLM_FALLBACK_KEY=

# Self-improvement: free models model-scout.js finds and verifies itself
# (docs/models.json) join the fallback chain automatically, after the fallback
# above, fastest first — no need to add them here by hand. Set to false to
# only ever use the fallback configured explicitly above (or none).
# USE_SCOUTED_MODELS=false

# --- Optional orchestra: one goal, a durable task DAG ---
# Muse Spark is the dedicated Conductor planner. It does not replace MODEL_*.
# MUSE_API_KEY=your-meta-model-api-key
# ORCHESTRA_PLANNER_PROVIDER=openai-compatible
# ORCHESTRA_PLANNER_URL=https://api.meta.ai/v1
# ORCHESTRA_PLANNER_MODEL=muse-spark-1.1
# ORCHESTRA_PLANNER_KEY=
#
# Hermes is a WSL2 worker. Point this at an installed Hermes command; WinAgent
# executes it as `wsl.exe -- <HERMES_COMMAND> "task goal"` without a host shell.
# HERMES_COMMAND=hermes
#
# OpenClaw supports an owner-operated command bridge or an authenticated local
# HTTP bridge. HTTP bridge contract: POST <URL><TASK_PATH> JSON {goal,taskId,runId,worker}.
# OPENCLAW_COMMAND=
# OPENCLAW_URL=http://127.0.0.1:8787
# OPENCLAW_TASK_PATH=/tasks
# OPENCLAW_TOKEN=
#
# Cloud worker: dispatches this repository workflow with goal/run_id/task_id inputs.
# CLOUD_WORKFLOW=cloud-worker.yml
# CLOUD_REF=main
# ORCHESTRA_CONCURRENCY=2
# ORCHESTRA_BUDGET_MS=1200000

# Optional Android bridge when controlling a phone through adb:
# ANDROID_SERIAL=DEVICE_SERIAL

# FULL AGENT MODE (autonomous, no approval prompts — only for tasks you trust):
# AUTO_YES=true
# Silent running: the agent never opens visible windows. All PowerShell runs hidden,
# apps launch normally only when the task needs a visible app. Never uses interactive consoles.
