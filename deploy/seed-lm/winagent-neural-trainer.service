[Unit]
Description=AchLLM CPU neural smoke trainer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/winagent
Environment=ACHLLM_NEURAL_CYCLE_SECONDS=3
Environment=ACHLLM_NEURAL_MICRO_STEPS=1
Environment=ACHLLM_NEURAL_EVALUATE_EVERY=20
Environment=ACHLLM_NEURAL_BATCH=1
Environment=ACHLLM_NEURAL_MAX_MB=512
ExecStart=%h/.local/share/achllm-neural/bin/python %h/winagent/neural/daemon.py
Restart=always
RestartSec=60
Nice=10
CPUQuota=90%
MemoryHigh=85%
MemoryMax=90%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/winagent/models

[Install]
WantedBy=default.target
