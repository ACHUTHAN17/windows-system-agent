[Unit]
Description=AchLLM CPU neural smoke trainer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/winagent
Environment=ACHLLM_NEURAL_INTERVAL_SECONDS=21600
Environment=ACHLLM_NEURAL_STEPS=200
Environment=ACHLLM_NEURAL_MAX_MB=512
ExecStart=%h/.local/share/achllm-neural/bin/python %h/winagent/neural/daemon.py
Restart=always
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/winagent/models

[Install]
WantedBy=default.target
