# Create this file with `node scripts/configure-public-proxy.mjs` on the server.
# It must be mode 600 and must contain only the password hash, never a raw password.
WINAGENT_PROXY_USER=replace-with-owner-name
WINAGENT_PROXY_PASSWORD_HASH=$scrypt$N=16384,r=8,p=1$base64-salt$base64-hash
WINAGENT_CORS_ORIGIN=https://achuthan17.github.io
# /achllm/status and /achllm/history are read-only, public telemetry for this
# origin. Chat still requires the username and password above.
