{
  "name": "winagent-desktop",
  "productName": "WinAgent",
  "version": "1.3.2",
  "description": "WinAgent desktop app: a ChatGPT/Codex-style window for the WinAgent system-control agent",
  "main": "main.js",
  "author": {
    "name": "ACHUTHAN17",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/ACHUTHAN17/windows-system-agent",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "npm run dist:win",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "com.achuthan17.winagent",
    "productName": "WinAgent",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "agent",
        "filter": [
          "src/**/*",
          "skills/**/*",
          "docs/**/*",
          "memory/**/*",
          "package.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "WinAgent-macOS-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "maintainer": "ACHUTHAN17 <noreply@github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "artifactName": "WinAgent-Linux-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinAgent",
      "artifactName": "WinAgent-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WinAgent-Portable-${version}.${ext}"
    }
  }
}
