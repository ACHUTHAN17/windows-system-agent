{
  "name": "windows-system-agent",
  "version": "1.42.7",
  "description": "Cross-platform system agent: offline device control plus optional free cloud planning",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "win-agent": "./src/index.js",
    "win-agent-mcp": "./src/mcp-server.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "test": "node ./src/index.js --selftest",
    "mcp": "node ./src/mcp-server.js",
    "train:agent-model": "node ./scripts/train-agent-model.js",
    "train:seed-model": "node ./scripts/train-seed-lm.mjs",
    "serve:seed-model": "node ./scripts/serve-seed-lm.mjs",
    "train:seed-once": "node ./scripts/seed-train-once.mjs",
    "train:seed-daemon": "node ./scripts/seed-train-daemon.mjs",
    "distill:achllm-once": "node ./scripts/seed-distill-once.mjs",
    "status:achllm": "node ./scripts/write-achllm-status.mjs",
    "publish:achllm-status": "node ./scripts/publish-achllm-status.mjs",
    "train:achllm-neural": "python3 ./neural/train.py",
    "serve:achllm-neural": "python3 ./neural/serve.py",
    "eval:achllm-neural": "python3 ./neural/eval_chat.py"
  },
  "license": "UNLICENSED"
}
