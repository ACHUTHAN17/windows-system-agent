{
  "name": "windows-system-agent",
  "version": "1.36.0",
  "description": "Cross-platform system agent: offline device control plus optional free cloud planning",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "win-agent": "./src/index.js",
    "win-agent-mcp": "./src/mcp-server.js"
  },
  "scripts": {
    "start": "node ./src/index.js",
    "test": "node ./src/index.js --selftest",
    "mcp": "node ./src/mcp-server.js",
    "train:agent-model": "node ./scripts/train-agent-model.js",
    "train:seed-model": "node ./scripts/train-seed-lm.mjs",
    "serve:seed-model": "node ./scripts/serve-seed-lm.mjs"
  },
